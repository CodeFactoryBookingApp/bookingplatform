# Copy to .env and fill in real values. NEVER commit .env
# Supabase project (Settings -> API and Settings -> Database)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Database (Supabase connection string, session/direct mode port 5432, NOT 6543)
DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_USER=postgres.<project-ref>
DATABASE_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
# JPA_DDL_AUTO=update
# SPRING_PROFILES_ACTIVE=cloud
